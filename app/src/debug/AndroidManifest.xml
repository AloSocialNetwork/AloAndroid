<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug builds only: adb hands a push payload to the code FCM calls. DUMP is held by the shell, not by other apps. -->
        <receiver
            android:name=".AloDebugPushReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
