<?xml version="1.0" encoding="utf-8"?>
<!-- As in src/main, plus plain http for local test servers (this build type only). Our server's certificate is from Let's Encrypt. Android 7.0 does not know its root, so without these the app there
     cannot reach the server at all. This only adds trust in those two roots; everything else is the system's. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
            <certificates src="@raw/isrg_root_x2" />
        </trust-anchors>
    </base-config>
</network-security-config>
